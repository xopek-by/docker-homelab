TIME_ZONE=Europe/Warsaw
# Pause between sync runs, seconds
SYNC_INTERVAL=900
# A run that would delete more files than this aborts and alerts
MAX_DELETE=500
# Where rclone.conf and sync.log live on the host
CONFIG_DIR=/opt/docker_data/gdrive-sync
# Telegram alerts (Homelab group, Alerts topic)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_THREAD_ID=11
