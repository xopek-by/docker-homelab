# Offsets of the log files already sent, export queue
DATA_FOLDER=/opt/docker_data/otel-collector/data

# ca.crt, client.crt, client.key issued by the private CA on the Oracle VM (see ../zabbix-apm/README.md)
TLS_FOLDER=/opt/docker_data/otel-collector/tls

# Name of this Docker host as it should appear in OpenObserve / Zabbix APM
HOST_NAME=docker-apps

# OpenObserve OTLP/HTTP endpoint and base64("<email>:<password>") of its user
OPENOBSERVE_ENDPOINT=http://10.0.0.101:5080/api/default
OPENOBSERVE_AUTH=base64-of-email-colon-password

# Zabbix APM proxy behind nginx on the Oracle VM (OTLP/gRPC with mutual TLS)
ZABBIX_APM_ENDPOINT=<oracle-public-ip>:443
