# Offsets of the log files already sent
DATA_FOLDER=/opt/docker_data/otel-collector

# Name of this Docker host as it should appear in OpenObserve / Zabbix APM
HOST_NAME=docker-apps

# OpenObserve OTLP/HTTP endpoint and base64("<email>:<password>") of its user
OPENOBSERVE_ENDPOINT=http://10.0.0.101:5080/api/default
OPENOBSERVE_AUTH=base64-of-email-colon-password

# Zabbix proxy with StartAPMCollector=1 (OTLP/gRPC)
ZABBIX_APM_ENDPOINT=10.0.0.110:4317
