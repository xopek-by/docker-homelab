# Seafile 13 stack (variable names follow the official 13.0 env file)
SEAFILE_VOLUME=/opt/seafile-data
SEAFILE_MYSQL_VOLUME=/opt/seafile-mysql/db
SEAFILE_SERVER_HOSTNAME=seafile.example.com
SEAFILE_SERVER_PROTOCOL=https
TIME_ZONE=Europe/Warsaw
# Random string, >= 32 chars
JWT_PRIVATE_KEY=
SEAFILE_MYSQL_DB_PASSWORD=
# Root password of the MariaDB container (also used by Seafile on first start)
INIT_SEAFILE_MYSQL_ROOT_PASSWORD=
# Only used on first start
INIT_SEAFILE_ADMIN_EMAIL=me@example.com
INIT_SEAFILE_ADMIN_PASSWORD=
