PUID=1000
PGID=1000
TZ=Europe/Warsaw
CONFIG_ROOT=/opt/docker_data
MEDIA_ROOT=/mnt/media
# One-time token from https://www.plex.tv/claim (valid 4 minutes), only needed for the first start.
PLEX_CLAIM=
# Media watchdog: Telegram group and topic for alerts (bot token is read from /opt/docker_data/telegram/BOT_TOKEN)
TG_CHAT_ID=-1000000000000
TG_TOPIC_ID=
STUCK_HOURS=3
REALERT_HOURS=24
CHECK_INTERVAL=1800
